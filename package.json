{
  "name": "hono-framework",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/playground dev",
    "cli": "bun run --cwd apps/playground cli",
    "mcp": "bun run packages/ai-mcp/src/index.ts",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "release": "bun scripts/release.ts",
    "sync:repos": "bun scripts/sync-repos.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test ./packages ./apps",
    "coverage": "bun scripts/coverage.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:up": "docker compose -f deployment/compose.yaml up -d --wait",
    "db:down": "docker compose -f deployment/compose.yaml down"
  },
  "trustedDependencies": [
    "docs"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
