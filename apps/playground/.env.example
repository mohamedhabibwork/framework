# Placeholders only. Copy to .env and replace values; never commit real credentials.
APP_NAME=playground
APP_ENV=development
APP_DEBUG=false

HTTP_HOST=127.0.0.1
HTTP_PORT=3000
CORS_ORIGINS=http://localhost:5173
HTTP_MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgres://postgres:@127.0.0.1:54329/DATABASE
DATABASE_MAX_CONNECTIONS=10

# Kit-backed subsystems (cache/logging/storage providers):
# CACHE_DRIVER=memory|redis (default redis; CACHE_URL falls back to REDIS_URL)
# CACHE_URL=redis://127.0.0.1:6379
# CACHE_PREFIX=playground
# LOG_LEVEL=info
# LOG_DRIVER=console (file requires LOG_FILE_PATH)
# STORAGE_ROOT=<absolute path; defaults to <playground>/storage>

